# Copy to .env and adjust. .env is git-ignored.

SERVER_PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blogapp
DB_USERNAME=blogapp
DB_PASSWORD=change-me

# JPA
JPA_SHOW_SQL=false
JPA_DDL_AUTO=update

# JWT: base64-encoded key of at least 32 bytes. Generate with: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Admin account created on startup if it does not exist (leave ADMIN_EMAIL empty to skip)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin
